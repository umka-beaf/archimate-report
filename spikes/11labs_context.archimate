    <element xsi:type="archimate:AssociationRelationship" id="id-d48df230ce4e4eebe9c657cdf9147e94" source="id-cd9b9b531f8f4806799d5bc794cbab46" target="id-1aa8f575eed1541910df68b8a448545b" name="читает из MySQL"/>
