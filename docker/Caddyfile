{
	admin off
	auto_https off

	# No `output file ...` here on purpose — logs go to stdout, which
	# `docker logs` captures directly. Nothing is ever written to disk,
	# so there is no log file to grow/rotate.
	log {
		output stdout
		format console
	}
}

:{$PORT} {
	# archi-webhook listens on 127.0.0.1:8088 only — it is never exposed
	# directly, only reachable through this reverse proxy. /status is always
	# routed there (even if WEBHOOK_SECRET is unset, in which case the
	# listener just answers 404 for the webhook path itself).
	handle {$WEBHOOK_PATH:/webhook}* {
		reverse_proxy 127.0.0.1:8088
	}
	handle /status {
		reverse_proxy 127.0.0.1:8088
	}
	# Multi-model mode (see docs/MULTI_MODEL.md): each model's webhook/status
	# lives under its own slug prefix, e.g. /myslug/webhook, /myslug/status.
	# This Caddyfile is static and doesn't know the configured slugs (they're
	# env-driven, discovered by archi-webhook itself at startup) — it just
	# forwards anything shaped like <segment>/webhook or <segment>/status
	# there, and archi-webhook 404s any slug it doesn't recognize. `*` matches
	# within one path segment only (does not cross `/`), so this can't
	# accidentally swallow deeper report paths like /myslug/img/status.png.
	# WEBHOOK_PATH is not consulted here — per §32.1 it has no meaning once
	# slugs are in play, the per-model webhook path is always /<slug>/webhook.
	handle /*/webhook {
		reverse_proxy 127.0.0.1:8088
	}
	handle /*/status {
		reverse_proxy 127.0.0.1:8088
	}
	handle {
		root * /data/report
		file_server
	}
	encode gzip

	# No access-log directive here either — kept off to avoid disk growth.
	# If per-request logging is wanted later, add `log { output stdout }`
	# inside this block (still stdout-only, never a file).
}
