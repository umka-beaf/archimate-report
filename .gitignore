# Downloaded third-party Archi distribution (~300MB), reproducible via
# https://github.com/archimatetool/archi.io/releases — not our content.
/Archi/

# Cloned example repositories used only to inspect format/structure —
# they are their own git repos (nested .git), not ours to track.
spikes/coarchi-example/
spikes/coarchi-glycam/

# Cloned upstream Archi source (nested .git) + Tycho/Maven build output and
# raw build logs — reproducible from upstream, not ours to track.
spikes/archi-source/
spikes/archi-source-build-logs/

# Generated report output from spikes — reproducible artifacts (mostly
# vendored static assets bootstrap/jquery/alasql copied by Archi itself).
# Keep the source models and run logs, drop the generated HTML/PNG output.
/spikes/m0-cli-report/report/
/spikes/m0-cli-report/report-archisurance/
/spikes/coarchi-glycam-report/
/spikes/item3-properties-test/report/

